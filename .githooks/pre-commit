#!/usr/bin/env sh
# pre-commit：版本一致性【提醒】——只警告，绝不阻断提交。
#
# 设计原则：分多次提交（先改 gradle、再改 README）是正常工作方式，
# 不应被禁止。这里只负责「让你不会忘」，把关交给发布前的 --strict 检查。

changed=$(git diff --cached --name-only)
case "$changed" in
  *gradle.properties*|*README.md*)
    bash scripts/check_release_consistency.sh >/tmp/_tacz_consistency.log 2>&1
    findings=$(sed 's/\x1b\[[0-9;]*m//g' /tmp/_tacz_consistency.log | grep -E '^[[:space:]]+FAIL')
    if [ -n "$findings" ]; then
      echo ""
      echo "──────────────────────────────────────────────────────────"
      echo " 提醒：README 与 gradle.properties 的版本号目前不一致。"
      echo ""
      printf '%s\n' "$findings" | sed 's/^/   /'
      echo ""
      echo " 若你正分步提交（先改版本号，稍后再补 README），可忽略本提醒。"
      echo " 发布前请务必跑通： bash scripts/check_release_consistency.sh --strict"
      echo " 详见 AGENTS.md §1。"
      echo "──────────────────────────────────────────────────────────"
      echo ""
    fi
    ;;
esac

# 永远放行。
exit 0
