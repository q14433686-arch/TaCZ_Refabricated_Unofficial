diff --git a/gradle.properties b/gradle.properties
index 24e3c26..3f17bec 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -21,7 +21,7 @@ loom_version=1.17.19
 #
 # 「1.1.8」是本移植所基于的上游 TACZ 版本（对应 Forge 的 1.1.8-hotfix，
 # 默认枪包 gunpack_info.json 里写的也正是 1.1.8）。
-# 「+fabric.1.21.11.R2.hotfix」是 SemVer 的<b>构建元数据</b>(build metadata)。
+# 「+fabric.1.21.11.R2-hotfix」是 SemVer 的<b>构建元数据</b>(build metadata)。
 #
 # 为什么用 '+' 而不是 '-'（这是关键，选错会让枪包全部加载失败）：
 # Fabric 的 SemanticVersionImpl#compareTo 逐条读过源码后确认——
@@ -29,12 +29,12 @@ loom_version=1.17.19
 #   * <b>build（'+' 后面那段）从头到尾不参与比较</b>；
 #   * prerelease 存在时【小于】同数字段的正式版。
 # 于是：
-#   1.1.8+fabric.1.21.11.R2.hotfix vs 1.1.8  ->  0   即 >=1.1.8 成立
+#   1.1.8+fabric.1.21.11.R2-hotfix vs 1.1.8  ->  0   即 >=1.1.8 成立
 #   1.1.8-fabric.1          vs 1.1.8  -> -1   即 >=1.1.8 不成立
 # 枪包 gunpack.meta.json 里的 dependencies 会走 VersionPredicate.parse 与本版本号比对
 #（GunPackLoader#modVersionMatch / VersionChecker#modVersionMatch）。
 # 若写成 '-fabric...'，凡是要求 ">=1.1.8" 的枪包都会被静默拒绝加载。
-mod_version=1.1.8+fabric.1.21.11.R2.hotfix
+mod_version=1.1.8+fabric.1.21.11.R2-hotfix
 maven_group=cn.sh1rocu
 archives_base_name=TACZ-Refabricated
 
