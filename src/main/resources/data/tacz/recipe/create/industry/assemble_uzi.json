      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": {
        "fabric:type": "forge:partial_nbt",
        "items": [
          "tacz:gun_component"
        ],
        "nbt": {
          "IndustryPlatform": "default_uzi",
          "IndustryPartKind": "barrel",
          "IndustryDisplayName": "item.tacz.gun_component.default_uzi_barrel"
        }
      },
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": {
        "fabric:type": "forge:partial_nbt",
        "items": [
          "tacz:gun_component"
        ],
        "nbt": {
          "IndustryPlatform": "default_uzi",
          "IndustryPartKind": "trigger",
          "IndustryDisplayName": "item.tacz.gun_component.default_uzi_trigger"
        }
      },
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
