    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "minecraft:leather",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "minecraft:leather",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "minecraft:leather",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "create:brass_sheet",
      "results": [
        "$result"
      ]
    }
