{
  "fabric:load_conditions": [
    {
      "condition": "fabric:all_mods_loaded",
      "values": [
        "create"
      ]
    }
  ],
  "type": "create:sequenced_assembly",
  "ingredient": {
    "fabric:type": "forge:partial_nbt",
    "items": [
      "tacz:gun_component"
    ],
    "nbt": {
      "IndustryPlatform": "default_uzi",
      "IndustryPartKind": "receiver",
      "IndustryDisplayName": "item.tacz.gun_component.default_uzi_receiver"
    }
  },
  "transitional_item": {
    "id": "tacz:gun_component",
    "components": {
      "minecraft:custom_data": {
        "IndustryPlatform": "default_uzi",
        "IndustryPartKind": "incomplete_uzi",
        "IndustryDisplayName": "item.tacz.gun_component.incomplete_uzi"
      }
    }
  },
  "result": {
    "id": "tacz:modern_kinetic_gun",
    "components": {
      "minecraft:custom_data": {
        "GunId": "tacz:vector45",
        "GunFireMode": "AUTO",
        "GunCurrentAmmoCount": 0,
        "HasBulletInBarrel": false
      }
    }
  },
  "sequence": [
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": {
        "fabric:type": "forge:partial_nbt",
