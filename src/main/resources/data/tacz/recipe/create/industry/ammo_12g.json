{
  "fabric:load_conditions": [
    {
      "condition": "fabric:all_mods_loaded",
      "values": [
        "create"
      ]
    }
  ],
  "type": "create:sequenced_assembly",
  "ingredient": {
    "fabric:type": "forge:partial_nbt",
    "items": [
      "tacz:cartridge_case"
    ],
    "nbt": {
      "IndustryPlatform": "ammunition",
      "IndustryPartKind": "case",
      "IndustryDisplayName": "item.tacz.cartridge_case.12g",
      "CartridgeCaliber": "12g"
    }
  },
  "transitional_item": {
    "id": "tacz:cartridge_case",
    "components": {
      "minecraft:custom_data": {
        "IndustryPlatform": "ammunition",
        "IndustryPartKind": "loading_12g",
        "IndustryDisplayName": "item.tacz.cartridge_case.loading_12g",
        "CartridgeCaliber": "12g"
      }
    }
  },
  "result": {
    "id": "tacz:ammo",
    "components": {
      "minecraft:custom_data": {
        "AmmoId": "tacz:12g"
      }
    }
  },
  "sequence": [
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": {
        "fabric:type": "forge:partial_nbt",
        "items": [
          "tacz:projectile_core"
        ],
        "nbt": {
          "IndustryPlatform": "ammunition",
          "IndustryPartKind": "projectile",
          "IndustryDisplayName": "item.tacz.projectile_core.12g_shot",
          "CartridgeCaliber": "12g",
          "ProjectileType": "shot"
        }
      },
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "tacz:primer",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "tacz:industrial_propellant",
      "results": [
        "$result"
      ]
    },
    {
      "type": "create:pressing",
      "ingredient": "$ingredient",
      "results": [
        "$result"
      ]
    }
  ]
}
