{
  "schemaVersion": 1,
  "id": "tacz",
  "provides": [
    "lrtactical",
    "taczmeshloader"
  ],
  "version": "${version}",
  "name": "[UNOFFICIAL] TaCZ Refabricated (1.21.11 R1)",
  "description": "Unofficial Fabric port of Timeless & Classics Guns: Zero for Minecraft ${minecraft_version}. TaCZ 1.2.0 backport candidate. Third-party pack compatibility depends on data, scripts and version constraints. Not affiliated with or endorsed by the TACZ Dev Team. Build: ${version}.",
  "authors": [
    "Sh1roCu"
  ],
  "contact": {},
  "license": "GPL3 / CC BY-NC-ND 4.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "cn.sh1rocu.tacz.client.TaCZFabricClient"
    ],
    "main": [
      "cn.sh1rocu.tacz.TaCZFabric"
    ],
    "modmenu": [
      "cn.sh1rocu.tacz.compat.modmenu.ModMenuApiImpl"
    ],
    "jei_mod_plugin": [
      "com.tacz.guns.compat.jei.GunModPlugin"
    ],
    "rei_client": [
      "cn.sh1rocu.tacz.compat.rei.REIClientPlugin"
    ],
    "rei_common": [
      "cn.sh1rocu.tacz.compat.rei.REIPlugin"
    ]
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/world/entity/LivingEntity": [
        "cn/sh1rocu/tacz/api/mixin/ItemHandlerCapability"
      ]
    }
  },
  "mixins": [
    "tacz.mixins.json",
    "tacz.fabric.mixins.json",
    "tacz.iris.mixins.json",
    "tacz.voxy.mixins.json",
    "tacz.carryon.mixins.json",
    "tacz.mesh.mixins.json",
    "lrtactical.mixins.json"
  ],
  "accessWidener": "tacz.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=0.141.6",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "forgeconfigapiport": ">=21.11.1"
  },
  "suggests": {
    "carryon": ">=2.9.2",
    "controllable": ">=0.25.7",
    "shouldersurfing": ">=5.0.0",
    "iris": ">=1.10.7",
    "sodium": ">=0.8.13"
  }
}