{
  "schemaVersion": 1,
  "id": "tacz",
  "provides": [
    "lrtactical"
  ],
  "version": "${version}",
  "name": "[UNOFFICIAL] TaCZ Refabricated (1.21.11 R9)",
  "description": "An unofficial Fabric port of Timeless & Classics Guns: Zero, based on upstream 1.1.8-hotfix. R9 for Minecraft 1.21.11 includes the built-in LRTactical compatibility layer and supports most standard, unencrypted ZIP knife packs. It is not affiliated with or endorsed by the TACZ Dev Team. The version keeps 1.1.8 as its SemVer core and uses '+fabric.1.21.11.R9' build metadata so existing pack version requirements continue to work.",
  "authors": [
    "Sh1roCu"
  ],
  "contact": {},
  "license": "GPL3 / CC BY-NC-ND 4.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "cn.sh1rocu.tacz.client.TaCZFabricClient"
    ],
    "main": [
      "cn.sh1rocu.tacz.TaCZFabric"
    ],
    "modmenu": [
      "cn.sh1rocu.tacz.compat.modmenu.ModMenuApiImpl"
    ],
    "jei_mod_plugin": [
      "com.tacz.guns.compat.jei.GunModPlugin"
    ],
    "rei_client": [
      "cn.sh1rocu.tacz.compat.rei.REIClientPlugin"
    ],
    "rei_common": [
      "cn.sh1rocu.tacz.compat.rei.REIPlugin"
    ]
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/world/entity/LivingEntity": [
        "cn/sh1rocu/tacz/api/mixin/ItemHandlerCapability"
      ]
    }
  },
  "mixins": [
    "tacz.mixins.json",
    "tacz.fabric.mixins.json",
    "tacz.iris.mixins.json",
    "lrtactical.mixins.json"
  ],
  "accessWidener": "tacz.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=0.141.6",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "forgeconfigapiport": ">=21.11.1"
  },
  "suggests": {
    "carryon": ">=2.10.0",
    "controllable": ">=0.25.7",
    "shouldersurfing": ">=5.0.0",
    "iris": ">=1.10.7",
    "sodium": ">=0.8.13"
  }
}