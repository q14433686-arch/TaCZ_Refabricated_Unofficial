{
  "schemaVersion": 1,
  "id": "tacz",
  "provides": [
    "lrtactical",
    "taczmeshloader"
  ],
  "version": "${version}",
  "name": "[UNOFFICIAL] TaCZ Refabricated (26.1.2 R1)",
  "description": "Unofficial Fabric port of Timeless & Classics Guns: Zero for Minecraft ${minecraft_version}. Includes the TaCZ 1.2.0 feature and default-pack backport, with 26.1.2-specific gun-pack conversion, optics and thermal rendering. Compatibility with third-party packs depends on their data, scripts and version constraints. Not affiliated with or endorsed by the TACZ Dev Team. Build: ${version}.",
  "authors": [
    "Sh1roCu"
  ],
  "contributors": [
    "TACZ Dev Team (upstream Timeless & Classics Guns: Zero)",
    "LesRaisins (LRTactical, ported portions)",
    "VellEagle (TacZ Mesh Loader, ported portions)"
  ],
  "contact": {},
  "license": "GPL3 / CC BY-NC-ND 4.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "cn.sh1rocu.tacz.client.TaCZFabricClient"
    ],
    "main": [
      "cn.sh1rocu.tacz.TaCZFabric"
    ],
    "modmenu": [
      "cn.sh1rocu.tacz.compat.modmenu.ModMenuApiImpl"
    ],
    "jei_mod_plugin": [
      "com.tacz.guns.compat.jei.GunModPlugin"
    ],
    "rei_client": [
      "cn.sh1rocu.tacz.compat.rei.REIClientPlugin"
    ],
    "rei_common": [
      "cn.sh1rocu.tacz.compat.rei.REIPlugin"
    ]
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/world/entity/LivingEntity": [
        "cn/sh1rocu/tacz/api/mixin/ItemHandlerCapability"
      ]
    }
  },
  "mixins": [
    "tacz.mixins.json",
    "tacz.fabric.mixins.json",
    "tacz.iris.mixins.json",
    "tacz.voxy.mixins.json",
    "tacz.carryon.mixins.json",
    "tacz.mesh.mixins.json",
    "lrtactical.mixins.json"
  ],
  "accessWidener": "tacz.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "26.1.2",
    "java": ">=25",
    "forgeconfigapiport": ">=26.1.5"
  },
  "suggests": {
    "carryon": ">=2.10.0"
  }
}
