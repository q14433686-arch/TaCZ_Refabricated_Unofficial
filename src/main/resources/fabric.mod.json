{
  "schemaVersion": 1,
  "id": "tacz",
  "provides": [
    "lrtactical"
  ],
  "version": "${version}",
  "name": "[UNOFFICIAL] TaCZ Refabricated (26.2 R2-hotfix)",
  "description": "An unofficial Fabric port of Timeless & Classics Guns: Zero, based on upstream 1.1.8-hotfix. R2 for Minecraft 26.2 adds the stable replaceable-ammunition and named gameplay-hook surfaces, Carry On 2.11 workbench compatibility, built-in JEI/REI Ammo Query, and post-sync recipe-viewer refreshes. It is not affiliated with or endorsed by the TACZ Dev Team. The version keeps 1.1.8 as its SemVer core and uses '+fabric.26.2.R2-hotfix' build metadata so existing gun-pack version requirements continue to work.",
  "authors": [
    "Sh1roCu"
  ],
  "contact": {},
  "license": "GPL3 / CC BY-NC-ND 4.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "cn.sh1rocu.tacz.client.TaCZFabricClient"
    ],
    "main": [
      "cn.sh1rocu.tacz.TaCZFabric"
    ],
    "modmenu": [
      "cn.sh1rocu.tacz.compat.modmenu.ModMenuApiImpl"
    ],
    "jei_mod_plugin": [
      "com.tacz.guns.compat.jei.GunModPlugin"
    ],
    "rei_client": [
      "cn.sh1rocu.tacz.compat.rei.REIClientPlugin"
    ],
    "rei_common": [
      "cn.sh1rocu.tacz.compat.rei.REIPlugin"
    ]
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/world/entity/LivingEntity": [
        "cn/sh1rocu/tacz/api/mixin/ItemHandlerCapability"
      ]
    }
  },
  "mixins": [
    "tacz.mixins.json",
    "tacz.fabric.mixins.json",
    "tacz.iris.mixins.json",
    "tacz.voxy.mixins.json",
    "tacz.punchy.mixins.json",
    "tacz.carryon.mixins.json",
    "lrtactical.mixins.json"
  ],
  "accessWidener": "tacz.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "26.2",
    "java": ">=25",
    "forgeconfigapiport": ">=26.2.1"
  },
  "suggests": {
    "carryon": ">=2.11.0",
    "punchy": "*"
  }
}
