{
  "schemaVersion": 1,
  "id": "tacz",
  "provides": [
    "lrtactical"
  ],
  "version": "${version}",
  "name": "[UNOFFICIAL] TaCZ Refabricated (26.1.2 HOTFIX)",
  "description": "An unofficial Fabric port of Timeless & Classics Guns: Zero, based on upstream 1.1.8-hotfix. HOTFIX build for Minecraft 26.1.2 - not affiliated with or endorsed by the TACZ Dev Team. The version keeps 1.1.8 as its SemVer core and uses '+fabric.26.1.2.HOTFIX2' build metadata so gun packs declaring a 'tacz' version requirement continue to load.",
  "authors": [
    "Sh1roCu"
  ],
  "contact": {},
  "license": "GPL3 / CC BY-NC-ND 4.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "cn.sh1rocu.tacz.client.TaCZFabricClient"
    ],
    "main": [
      "cn.sh1rocu.tacz.TaCZFabric"
    ],
    "modmenu": [
      "cn.sh1rocu.tacz.compat.modmenu.ModMenuApiImpl"
    ],
    "jei_mod_plugin": [
      "com.tacz.guns.compat.jei.GunModPlugin"
    ],
    "rei_client": [
      "cn.sh1rocu.tacz.compat.rei.REIClientPlugin"
    ],
    "rei_common": [
      "cn.sh1rocu.tacz.compat.rei.REIPlugin"
    ]
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/world/entity/LivingEntity": [
        "cn/sh1rocu/tacz/api/mixin/ItemHandlerCapability"
      ]
    }
  },
  "mixins": [
    "tacz.mixins.json",
    "tacz.fabric.mixins.json",
    "tacz.iris.mixins.json",
    "lrtactical.mixins.json"
  ],
  "accessWidener": "tacz.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=0.155.2",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "forgeconfigapiport": ">=26.1.5"
  },
  "suggests": {
    "carryon": ">=2.10.0",
    "controllable": ">=0.26.0",
    "shouldersurfing": ">=5.0.0",
    "iris": ">=1.11.2",
    "sodium": ">=0.9.1"
  }
}