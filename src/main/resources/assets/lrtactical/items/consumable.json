{
  "_comment": [
    "结构与 items/melee.json 完全相同，逐条说明见该文件。",
    "  on_true  -> lrtactical:dynamic_item，走 Bedrock 模型 + Lua 动画状态机（内容包提供 display 时）；",
    "  on_false -> 原版占位模型（本移植刻意不打包上游美术资源，其授权为 All Rights Reserved）。"
  ],
  "model": {
    "type": "minecraft:condition",
    "property": "lrtactical:has_custom_display",
    "on_true": {
      "type": "lrtactical:dynamic_item",
      "base": "lrtactical:item/consumable_dynamic"
    },
    "on_false": {
      "type": "minecraft:model",
      "model": "lrtactical:item/consumable"
    }
  },
  "properties": {
    "oversized_in_gui": true,
    "hand_animation_on_swap": false,
    "swap_animation_scale": 0.0
  }
}
